NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=mysql://root:password@localhost:3306/mann_ki_mannat
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
ADMIN_SETUP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Set to lax when the site and API share a custom parent domain. Production defaults to none for Netlify + Render.
ADMIN_COOKIE_SAME_SITE=
# bcrypt work factor for new password hashes (10-14). Lower is faster to sign in.
BCRYPT_ROUNDS=10
WHATSAPP_BUSINESS_NUMBER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOG_LEVEL=info
