{
  "name": "@mann-ki-mannat/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "node src/scripts/prepare-migrations.js && prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "test": "node --test",
    "admin:create": "node src/scripts/create-admin.js",
    "admin:reset": "node src/scripts/reset-admin.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.5.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "sanitize-html": "2.18.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "6.12.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
